# Orbit backend environment
# Local development default is SQLite. Switch to PostgreSQL by changing this URL only.
DATABASE_URL=sqlite:///./orbit.db

# "development" allows the default JWT_SECRET below.
# "production" refuses to start unless JWT_SECRET is a random string of at
# least 32 bytes, so a deployment can never silently ship the default secret.
ENVIRONMENT=development

# Secret used to sign JWT access tokens. Never commit a real secret.
JWT_SECRET=change-me-in-production

# Access token lifetime, in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Comma separated list of allowed origins for the browser client.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Uploaded images are stored here and served under /uploads.
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=5

# Optional. Leave empty to run the built-in rule based parser (no network calls).
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.openai.com/v1
